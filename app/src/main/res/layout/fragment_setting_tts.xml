<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="选择 TTS 引擎"
        android:textColor="@color/dn_text_color_black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_tts_engine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_tts_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="系统 TTS (默认)"
            android:textColor="@color/dn_text_color_black" />

        <RadioButton
            android:id="@+id/rb_tts_edge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edge TTS(网络合成)"
            android:textColor="@color/dn_text_color_black" />

    </RadioGroup>

    <Spinner
        android:id="@+id/spinner_tts_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />


    <!-- TTS rate setting (base 50) -->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="TTS语速 (默认 50)"
            android:textColor="@color/dn_text_color_black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_edge_rate_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="50"
            android:textColor="@color/dn_colorAccent" />
    </LinearLayout>


    <SeekBar
        android:id="@+id/seekbar_edge_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:max="100"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_tts_cancel"
            android:layout_width="0dp"

            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="取消" />

        <Button
            android:id="@+id/btn_tts_play"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="播放" />

    </LinearLayout>

</LinearLayout>

