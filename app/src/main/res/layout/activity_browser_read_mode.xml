<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <sjj.novel.view.reader.page.PageView
            android:id="@+id/read_mode_page_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 隐藏的 WebView，用于内容提取和章节导航 -->
        <WebView
            android:id="@+id/hidden_web_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- 设置面板容器 -->
        <FrameLayout
            android:id="@+id/read_mode_setting_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 章节目录抽屉 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chapter_list_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/dn_background_dialog"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/chapter_list_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/colorPrimary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="链接" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未标记" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="黑名单" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="白名单" />
        </com.google.android.material.tabs.TabLayout>

        <!-- 底部筛选栏：跨域过滤 -->
        <LinearLayout
            android:id="@+id/chapter_list_filter_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <CheckBox
                android:id="@+id/chapter_list_include_cross_domain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="包含跨域链接"
                android:textColor="@color/dn_text_color_black"
                android:textSize="13sp" />

        </LinearLayout>

        <sjj.novel.view.scroller.FastScrollRecyclerView
            android:id="@+id/chapter_list_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/dn_background_dialog"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/chapter_list_filter_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chapter_list_tab"
            tools:listitem="@layout/item_browser_chapter" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.drawerlayout.widget.DrawerLayout>
