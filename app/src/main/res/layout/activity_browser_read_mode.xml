<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <sjj.novel.view.reader.page.PageView
            android:id="@+id/read_mode_page_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/web_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- 后台 WebView，用于内容提取和章节导航；调试/查看原网页时可切到前台显示 -->
            <WebView
                android:id="@+id/hidden_web_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/browser_book_city_toolbar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/browser_book_city_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom"
                    android:clickable="true">

                    <ImageView
                        android:id="@+id/backward"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@mipmap/icon_exit"
                        app:layout_constraintEnd_toStartOf="@+id/forward"
                        app:layout_constraintStart_toStartOf="parent" />


                    <ImageView
                        android:id="@+id/forward"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/browser_navigation_forward"
                        app:layout_constraintEnd_toStartOf="@+id/refresh"
                        app:layout_constraintStart_toEndOf="@+id/backward" />

                    <ImageView
                        android:id="@+id/refresh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/browser_navigation_refresh"
                        app:layout_constraintEnd_toStartOf="@+id/toggle_web_view"
                        app:layout_constraintStart_toEndOf="@+id/forward" />


                    <ImageView
                        android:id="@+id/toggle_web_view"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@mipmap/ic_web_hide"
                        app:layout_constraintEnd_toStartOf="@+id/home"
                        app:layout_constraintStart_toEndOf="@+id/refresh"
                        app:tint="@color/dn_text_color_black" />

                    <ImageView
                        android:id="@+id/home"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/browser_navigation_home"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/toggle_web_view" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 后台 WebView 加载进度条（与 CustomWebView 浏览模式同一风格） -->
        <androidx.core.widget.ContentLoadingProgressBar
            android:id="@+id/hidden_web_view_progress"
            style="@style/ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:visibility="gone"
            tools:progress="50"
            tools:visibility="visible" />

        <!-- 设置面板容器 -->
        <FrameLayout
            android:id="@+id/read_mode_setting_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/chapter_list_drawer_container"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/dn_background_dialog" />

</androidx.drawerlayout.widget.DrawerLayout>
