<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/subtitle_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 字幕文字区：可拖动 / 点击展开设置 -->
    <FrameLayout
        android:id="@+id/subtitle_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_subtitle_panel"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="26dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/subtitle_lines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ImageView
            android:id="@+id/subtitle_lock"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="锁定字幕"
            android:padding="3dp"
            android:src="@drawable/ic_subtitle_unlock" />
    </FrameLayout>

    <!-- 设置面板：点击字幕区展开 -->
    <LinearLayout
        android:id="@+id/subtitle_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_subtitle_settings"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- 语速：系统 TTS 与 Edge 都需要 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="语速"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subtitle_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="50"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_subtitle_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <!-- 音色：仅 Edge 引擎显示 -->
        <LinearLayout
            android:id="@+id/subtitle_voice_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音色"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_subtitle_voice_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="‹"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_subtitle_voice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晓晓"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_subtitle_voice_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="›"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字号"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subtitle_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="17"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_subtitle_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="16"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="透明度"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subtitle_alpha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="85%"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_subtitle_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="行数"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subtitle_lines_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="2 行"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_subtitle_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="偏移(ms)"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subtitle_offset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="0"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_subtitle_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />
    </LinearLayout>
</LinearLayout>
