<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/subtitle_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 字幕文字区：整条铺满（文字可用宽度 = 屏幕宽 - 左右 padding）；关闭/设置按钮浮在上层且默认隐藏 -->
    <FrameLayout
        android:id="@+id/subtitle_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_subtitle_panel"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <!-- 固定高度窗口 + 内部整段 TextView：只显示其中 N 行，靠 translationY 滚动；两端对齐由 justificationMode 完成 -->
        <FrameLayout
            android:id="@+id/subtitle_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="true">

            <com.sjianjun.reader.tts.v2.subtitle.SubtitleTextView
                android:id="@+id/subtitle_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <ImageView
            android:id="@+id/subtitle_close"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭字幕"
            android:padding="4dp"
            android:src="@drawable/ic_tab_close"
            android:tint="#FFFFFFFF"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/subtitle_settings_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|end"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="字幕设置"
            android:padding="4dp"
            android:src="@drawable/ic_tts_settings"
            android:tint="#FFFFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 设置面板：点右下角设置图标展开 -->
    <LinearLayout
        android:id="@+id/subtitle_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_subtitle_settings"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字号"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subtitle_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="17"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_subtitle_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="16"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="透明度"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subtitle_alpha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="85%"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_subtitle_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="行数"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subtitle_lines_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="2 行"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_subtitle_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="偏移(ms)"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subtitle_offset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="0"
                android:textColor="#FF7CD992"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_subtitle_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />
    </LinearLayout>
</LinearLayout>
