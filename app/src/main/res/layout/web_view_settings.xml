<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flexbox_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:padding="5dp">

        <TextView
            android:id="@+id/web_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:longClickable="true"
            android:maxLines="3"
            android:padding="5dp"
            android:text="当前标题"
            android:textColor="@color/dn_reader_chapter_title_text_color"
            android:textIsSelectable="true"
            android:textSize="16dp"
            app:layout_constraintEnd_toStartOf="@+id/btn_copy_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.coorchice.library.SuperTextView
            android:id="@+id/web_title_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/web_title"
            app:layout_constraintEnd_toEndOf="@+id/web_title"
            app:layout_constraintStart_toStartOf="@+id/web_title"
            app:layout_constraintTop_toTopOf="@+id/web_title" />

        <com.coorchice.library.SuperTextView
            android:id="@+id/btn_copy_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="复制"
            android:textColor="@color/mdr_white"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/web_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/web_title"
            app:stv_corner="5dp"
            app:stv_solid="@color/colorPrimary" />


        <EditText
            android:id="@+id/url_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@color/transparent"
            android:maxLines="3"
            android:padding="5dp"
            android:text="http:://ss"
            android:textColor="@color/dn_reader_chapter_title_text_color"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/btn_copy_url"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/web_title" />

        <com.coorchice.library.SuperTextView
            android:id="@+id/url_input_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/url_input"
            app:layout_constraintEnd_toEndOf="@+id/url_input"
            app:layout_constraintStart_toStartOf="@+id/url_input"
            app:layout_constraintTop_toTopOf="@+id/url_input"
            app:stv_corner="5dp"
            app:stv_stroke_color="@color/dn_color_primary"
            app:stv_stroke_width="1dp" />

        <com.coorchice.library.SuperTextView
            android:id="@+id/btn_copy_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="复制"
            android:textColor="@color/mdr_white"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/url_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/url_input"
            app:stv_corner="5dp"
            app:stv_solid="@color/colorPrimary" />

        <TextView
            android:id="@+id/tv_font_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="字体大小："
            android:textColor="@color/dn_reader_chapter_title_text_color"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_font_subtract"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_font_subtract" />


        <com.coorchice.library.SuperTextView
            android:id="@+id/btn_font_subtract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="5dp"
            android:text="字体-"
            android:textColor="@color/mdr_white"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_font_size_value"
            app:layout_constraintStart_toEndOf="@+id/tv_font_size"
            app:layout_constraintTop_toBottomOf="@+id/url_input"
            app:stv_corner="5dp"
            app:stv_solid="@color/colorPrimary" />

        <TextView
            android:id="@+id/tv_font_size_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textColor="@color/dn_reader_chapter_title_text_color"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_font_subtract"
            app:layout_constraintEnd_toStartOf="@+id/btn_font_add"
            app:layout_constraintStart_toEndOf="@+id/btn_font_subtract"
            app:layout_constraintTop_toTopOf="@+id/btn_font_subtract" />

        <com.coorchice.library.SuperTextView
            android:id="@+id/btn_font_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="字体+"
            android:textColor="@color/mdr_white"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_font_subtract"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_font_size_value"
            app:layout_constraintTop_toTopOf="@+id/btn_font_subtract"
            app:stv_corner="5dp"
            app:stv_solid="@color/colorPrimary" />

        <TextView
            android:id="@+id/tv_cross_origin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="跨域："
            android:textColor="@color/dn_reader_chapter_title_text_color"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/rg_cross_origin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rg_cross_origin" />

        <RadioGroup
            android:id="@+id/rg_cross_origin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_cross_origin"
            app:layout_constraintTop_toBottomOf="@+id/btn_font_subtract">

            <RadioButton
                android:id="@+id/rb_ask"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="询问"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_allow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="允许"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_deny"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="拒绝"
                android:textSize="13sp" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/tv_ad_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_add_to_shelf"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rg_cross_origin">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="广告拦截"
                android:textColor="@color/mdr_white"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_add_to_shelf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_add_to_home"
            app:layout_constraintStart_toEndOf="@+id/tv_ad_block"
            app:layout_constraintTop_toBottomOf="@+id/rg_cross_origin">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@mipmap/ic_shelf"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+书架"
                android:textColor="@color/mdr_white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_add_to_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_read_mode"
            app:layout_constraintStart_toEndOf="@+id/btn_add_to_shelf"
            app:layout_constraintTop_toBottomOf="@+id/rg_cross_origin">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_browser_home"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+主页"
                android:textColor="@color/mdr_white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_read_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_add_to_home"
            app:layout_constraintTop_toBottomOf="@+id/rg_cross_origin">

            <TextView
                android:id="@+id/tv_read_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="阅读模式"
                android:textColor="@color/mdr_white"
                android:textSize="14sp" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>