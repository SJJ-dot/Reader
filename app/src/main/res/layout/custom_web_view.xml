<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/web_view_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/search_refresh"
        style="@style/ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        tools:progress="50"
        tools:visibility="visible" />

    <androidx.cardview.widget.CardView
        android:id="@+id/browser_book_city_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/dn_background_card"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="2dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#1F000000" />

            <!-- 地址栏 -->
            <LinearLayout
                android:id="@+id/address_row"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_browser_address"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/site_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/browser_navigation_view"
                    app:tint="#888888" />

                <TextView
                    android:id="@+id/tv_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="搜索或输入网址"
                    android:textColor="@color/dn_text_color_black"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/refresh"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/browser_navigation_refresh"
                    app:tint="@color/dn_text_color_black" />
            </LinearLayout>

            <!-- 底部按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/backward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:scaleX="-1"
                    android:src="@drawable/browser_navigation_forward" />

                <ImageView
                    android:id="@+id/forward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/browser_navigation_forward" />

                <TextView
                    android:id="@+id/new_tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/dn_text_color_black"
                    android:textSize="26sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tabs"
                        android:layout_width="24dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_browser_tab_count"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/dn_text_color_black"
                        android:textSize="12sp" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/browser_navigation_menu"
                    app:tint="@color/dn_text_color_black" />

                <!-- 首页：暂时收进菜单前先保留控件，避免代码引用失效 -->
                <ImageView
                    android:id="@+id/home"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
