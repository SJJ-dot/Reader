<?xml version="1.0" encoding="utf-8"?>
<!--
    阅读器菜单里的朗读播放卡片：进度 + 播放控制 + 定时停止 + 朗读设置入口。
    只在有朗读会话（且是当前这本书）时显示。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dn_reader_setting_btn"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tts_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dn_text_color_black"
                android:textSize="13sp"
                tools:text="第12章 章节名" />

            <TextView
                android:id="@+id/tts_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/dn_text_color_black_secondary"
                android:textSize="12sp"
                tools:text="42%" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/tts_progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressBackgroundTint="@color/dn_text_color_black_secondary"
            android:progressTint="@color/dn_colorAccent"
            tools:progress="42" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/tts_timer"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="定时停止"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tts_timer"
                app:tint="@color/dn_text_color_black" />

            <ImageButton
                android:id="@+id/tts_prev"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="上一章"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tts_prev"
                app:tint="@color/dn_text_color_black" />

            <ImageButton
                android:id="@+id/tts_toggle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="播放暂停"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tts_pause"
                app:tint="@color/dn_colorAccent" />

            <ImageButton
                android:id="@+id/tts_next"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="下一章"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tts_next"
                app:tint="@color/dn_text_color_black" />

            <ImageButton
                android:id="@+id/tts_stop"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="停止朗读"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tts_stop"
                app:tint="@color/dn_text_color_black" />
        </LinearLayout>

        <TextView
            android:id="@+id/tts_timer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dn_text_color_black_secondary"
            android:textSize="11sp"
            tools:text="定时停止：关闭" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
